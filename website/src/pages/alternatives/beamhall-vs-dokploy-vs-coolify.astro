---
import Sidebar from "../../components/Sidebar.astro";
import { pages, repo } from "../../nav";
import "../../styles/terminal.css";
import "../../styles/article.css";

const page = pages.find((p) => p.id === "alternatives")!;

const title =
  "Beamhall vs Dokploy vs Coolify: When the Person Shipping the App Is an AI Agent";
const description =
  "Dokploy and Coolify make self-hosting easier. Beamhall is built for a different problem: letting AI coding agents ship internal apps without giving them infrastructure credentials or control.";
const keywords = [
  "Beamhall",
  "Dokploy alternative",
  "Coolify alternative",
  "self-hosted AI app platform",
  "self-hosted PaaS",
  "Claude Code deployment",
  "vibe coding enterprise",
  "internal AI apps",
  "AI coding agents",
  "secure vibe coding",
].join(", ");
const published = "2026-08-26";
const modified = "2026-08-26";
const site = (Astro.site?.href ?? "https://beamhall.com/").replace(/\/$/, "");
const canonical = new URL(page.href, Astro.site ?? "https://beamhall.com").href;
// A plain-markdown twin of this article, for LLM crawlers and "view as
// markdown" flows. Emitted by ./beamhall-vs-dokploy-vs-coolify.md.ts.
const markdownUrl = "/alternatives/beamhall-vs-dokploy-vs-coolify.md";

// SERP-length title/description (the on-page h1 and standfirst stay long-form).
const metaTitle = "Beamhall vs Dokploy vs Coolify: which for AI-built apps?";
const metaDescription =
  "Dokploy and Coolify are self-hosted PaaS. Beamhall solves a different problem: letting AI coding agents ship internal apps without infrastructure credentials.";

// The comparison table, kept as data so the mobile card layout and the desktop
// grid stay in sync (each cell carries its column label for the stacked view).
const cols = ["Coolify", "Dokploy", "Beamhall"];
const rows: [string, string, string, string][] = [
  [
    "Primary design center",
    "Self-hosted PaaS for developers and operators",
    "Self-hosted PaaS with strong AI deployment integration",
    "Self-hosted backplane for AI-agent-built internal apps",
  ],
  [
    "AI integration",
    "Built-in MCP with team-scoped API authentication and supported operations",
    "Official MCP exposing broad Dokploy API coverage",
    "MCP is the primary agent-facing control surface",
  ],
  [
    "What the agent becomes",
    "An automation client for the PaaS",
    "A highly capable PaaS operator",
    "A requester of policy-governed application capabilities",
  ],
  [
    "Source workflow",
    "Git, images, services, other deployment paths",
    "Git, Docker image, Docker Compose",
    "Integrated private Git per app; agent handles the push",
  ],
  [
    "Build control",
    "Flexible Docker/source deployment model",
    "Flexible build, Docker and Compose model",
    "Controlled Buildpacks pipeline; agent cannot supply its own Dockerfile",
  ],
  [
    "Database credentials",
    "Managed as platform/application configuration",
    "Internal credentials and environment variables; external vaults supported",
    "Minted and injected by Beamhall; raw connection string is not returned to the agent",
  ],
  [
    "Secret handling",
    "Encrypted platform values and scoped API behavior",
    "Environment variables plus external secret providers; MCP can redact sensitive fields",
    "Write-only agent interface; secrets injected into the workload",
  ],
  [
    "Egress posture",
    "Operator-managed as part of server/workload security",
    "Isolation features available; host/network security remains an operator concern",
    "Default-deny per workspace; agent has no tool to widen it",
  ],
  [
    "Runtime hardening",
    "Operator/application responsibility",
    "Docker/Swarm deployment controls and isolation options",
    "IT-set immutable baseline; runc or gVisor tier",
  ],
  [
    "Production governance",
    "Teams, roles and token permissions",
    "Enterprise SSO, RBAC and audit features available",
    "Preview and live are separate lifecycle states; promotion can be IT-only with optional four-eyes approval",
  ],
  [
    "Application SSO",
    "Platform SSO options are focused on Coolify access",
    "Enterprise Application Authentication can protect deployed apps",
    "Company sign-in is a provisioned application capability",
  ],
  [
    "Open-source model",
    "Apache 2.0",
    "Core Apache 2.0; proprietary enterprise directory for paid functionality",
    "Apache 2.0",
  ],
  [
    "Current maturity",
    "Established project and ecosystem",
    "Established project with active AI/PaaS development",
    "Pre-1.0; currently moving into design-partner validation",
  ],
];

const sources: { href: string; label: string; who: string }[] = [
  { href: "/", label: "Beamhall overview, architecture, security model, features, and roadmap", who: "beamhall.com" },
  { href: repo, label: "Beamhall source repository and project status", who: "github.com" },
  { href: `${repo}/blob/main/docs/threat-model.md`, label: "Beamhall security and threat model", who: "github.com" },
  { href: "https://dokploy.com/deploy-ai", label: "Dokploy: Deploy AI Apps Securely", who: "dokploy.com" },
  { href: "https://github.com/Dokploy/mcp", label: "Dokploy official MCP server", who: "github.com" },
  { href: "https://docs.dokploy.com/docs/core/applications", label: "Dokploy application deployment model", who: "docs.dokploy.com" },
  { href: "https://docs.dokploy.com/docs/core/secrets-providers", label: "Dokploy secrets providers", who: "docs.dokploy.com" },
  { href: "https://docs.dokploy.com/docs/core/enterprise", label: "Dokploy Enterprise features", who: "docs.dokploy.com" },
  { href: "https://coolify.io/docs/get-started/introduction", label: "Coolify overview", who: "coolify.io" },
  { href: "https://coolify.io/docs/integrations/mcp", label: "Coolify MCP documentation", who: "coolify.io" },
  { href: "https://next.coolify.io/docs/core/security-model", label: "Coolify security model", who: "next.coolify.io" },
  { href: "https://next.coolify.io/docs/applications/deployments/overview", label: "Coolify deployment model", who: "next.coolify.io" },
];

// Key takeaways — the short, factual version of the argument. Rendered near the
// top of the article and reused verbatim in the markdown twin.
const takeaways: string[] = [
  "Coolify and Dokploy are self-hosted PaaS products: a developer or operator remains responsible for the infrastructure decisions. Beamhall is an application backplane whose intended operator is the AI coding agent.",
  "Both Dokploy and Coolify now ship MCP servers that let an agent drive the platform. Beamhall inverts the contract: the agent requests application capabilities and never becomes an infrastructure administrator.",
  "Beamhall treats the agent and the code it writes as untrusted. Database connection strings and secrets are injected into the running app, never returned to the agent, so prompt injection has nothing to steal.",
  "Beamhall's defaults are structural, not advisory: least privilege, read-only root filesystem, default-deny egress, IT-set resource ceilings and runtime tier, per-workspace isolation — with no agent tool to widen any of them.",
  "Preview and live are separate lifecycle states; promotion can be reserved for IT and optionally require four-eyes approval.",
  "Keep Dokploy or Coolify if your users are developers who want full control over images, Compose files and build strategies. Choose Beamhall if non-developers will build internal apps with AI and you need the constraints to be the product.",
  "Maturity trade-off: Coolify and Dokploy are established projects; Beamhall is pre-1.0 and entering design-partner validation.",
];

// Q&A pairs surfaced as FAQPage structured data. Each mirrors an H2 below.
const faq: { q: string; a: string }[] = [
  {
    q: "Is Beamhall a Dokploy alternative?",
    a: "Sometimes. If you want another general-purpose self-hosted PaaS, Beamhall is not what you want — it intentionally gives the agent less infrastructure freedom. If you are evaluating Dokploy because of its Claude Code and MCP story, and your real goal is employee-created internal applications, Beamhall is worth comparing: Dokploy exposes a powerful deployment platform to the agent, while Beamhall exposes a narrower application-capability model and keeps the infrastructure behind it. That is a different trust model, not a UI difference.",
  },
  {
    q: "Is Beamhall a Coolify alternative?",
    a: "It depends on the job. As a Coolify alternative for hosting arbitrary developer-managed workloads, Beamhall is deliberately narrower. As a self-hosted environment for secure vibe coding and AI-generated internal apps, it addresses concerns Coolify leaves to the operator: runtime posture, outbound-network defaults, capability provisioning, agent credential exposure, and the separation between building a preview and promoting an app to production. Coolify is a platform your developers operate; Beamhall is the platform your AI agent operates without becoming your infrastructure administrator.",
  },
  {
    q: "When should you keep Dokploy or Coolify?",
    a: "When your primary users are developers. Choose a general-purpose PaaS if your team wants direct control over Docker images, Compose definitions, build strategies, environment configuration, public applications and arbitrary services. Coolify is especially attractive if you want a mature, fully open-source self-hosted PaaS with a large ecosystem and no feature-lock between hosted and self-hosted. Dokploy is compelling if you want a modern PaaS that is aggressively integrating with AI coding tools, with broad official MCP coverage and enterprise governance features.",
  },
  {
    q: "What about Claude Code?",
    a: "Claude Code is the first agent Beamhall targets, but Beamhall's agent interface is MCP rather than a Claude-only deployment protocol. What matters is the contract on the other side of the MCP connection: a broad infrastructure API asks the model to make infrastructure decisions, while Beamhall's tool surface asks it only to state what the application needs.",
  },
];

// Structured data. `application/ld+json` is a data block, not an executable
// script, so it is unaffected by the site's `script-src 'self'` CSP.
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "TechArticle",
      "@id": `${canonical}#article`,
      headline: "Beamhall vs Dokploy vs Coolify: when the person shipping the app is an AI agent",
      alternativeHeadline: title,
      description: metaDescription,
      abstract: description,
      inLanguage: "en",
      articleSection: "Comparisons",
      keywords,
      datePublished: published,
      dateModified: modified,
      mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
      url: canonical,
      image: {
        "@type": "ImageObject",
        url: `${site}/og.png`,
        width: 1200,
        height: 630,
      },
      author: { "@type": "Organization", name: "Beamhall", url: `${site}/` },
      publisher: {
        "@type": "Organization",
        "@id": `${site}/#organization`,
        name: "Beamhall",
        url: `${site}/`,
        logo: { "@type": "ImageObject", url: `${site}/icon-512.png`, width: 512, height: 512 },
      },
      about: [
        { "@type": "SoftwareApplication", name: "Beamhall", applicationCategory: "DeveloperApplication" },
        { "@type": "SoftwareApplication", name: "Dokploy", applicationCategory: "DeveloperApplication" },
        { "@type": "SoftwareApplication", name: "Coolify", applicationCategory: "DeveloperApplication" },
      ],
      citation: sources.filter((x) => !x.href.startsWith("/")).map((x) => x.href),
      encoding: {
        "@type": "MediaObject",
        encodingFormat: "text/markdown",
        contentUrl: `${site}${markdownUrl}`,
      },
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonical}#breadcrumbs`,
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Beamhall", item: `${site}/` },
        { "@type": "ListItem", position: 2, name: "Alternatives", item: `${site}/alternatives/` },
        { "@type": "ListItem", position: 3, name: "Beamhall vs Dokploy vs Coolify", item: canonical },
      ],
    },
    {
      "@type": "FAQPage",
      "@id": `${canonical}#faq`,
      mainEntity: faq.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
  ],
};
